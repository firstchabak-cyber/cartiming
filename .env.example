# ── Supabase ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini ────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── 네이버 OAuth (Custom) ────────────────────────
# 배포시 NAVER_REDIRECT_URI를 실제 도메인으로 교체 + 네이버 개발자센터 Callback URL 등록 갱신
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:3000/api/auth/naver/callback

# ── 차량 정보 조회 (data.go.kr B553881) ──────────
# mock | data-go-kr
VEHICLE_LOOKUP_PROVIDER=data-go-kr
DATA_GO_KR_API_KEY=your-data-go-kr-key
DATA_GO_KR_VEHICLE_LOOKUP_URL=https://apis.data.go.kr/B553881/MnfctEntrsInfo_01/getMnfctEntrsInfo

# ── App ──────────────────────────────────────────
# 배포시 실제 도메인 (예: https://cartiming.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 토스페이먼츠 ─────────────────────────────────
# 키 발급: https://developers.tosspayments.com
# 미설정 시 토스 공개 테스트 키로 자동 폴백 (실제 결제 X)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# ── Cron 보안 토큰 ───────────────────────────────
CRON_SECRET=your-cron-secret

# ── 웹 푸시 알림 (VAPID) ─────────────────────────
# 키 생성: npx web-push generate-vapid-keys
# 미설정 시 푸시는 자동 비활성 (인앱 알림은 계속 작동)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:help@cartiming.app

# ── 이메일 알림 (SMTP) ───────────────────────────
# 네이버웍스: smtp.worksmobile.com / 포트 587 / SECURE=false
# 미설정 시 이메일 발송은 자동 비활성 (인앱·푸시는 계속 작동)
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=help@cartiming.app
SMTP_PASS=your-app-password
SMTP_FROM=카타임 <help@cartiming.app>
